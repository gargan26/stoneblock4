{
  "id": "create_copper_blocks",
  "name": {
    "translate": "collapsible_groups.group.create_copper_blocks",
    "fallback": "Create: Copper Blocks"
  },
  "enabled": true,
  "filter": {
    "all": [
      {
        "type": "item",
        "namespace": "create"
      },
      {
        "any": [
          {
            "item_path_contains": "copper_shingle"
          },
          {
            "item_path_contains": "copper_tile"
          }
        ]
      },
      {
        "not": {
          "item_path_contains": "exposed_copper"
        }
      },
      {
        "not": {
          "item_path_contains": "weathered_copper"
        }
      },
      {
        "not": {
          "item_path_contains": "oxidized_copper"
        }
      }
    ]
  }
}
